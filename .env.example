# ════════════════════════════════════════════════════════════
#  threatintel-platform — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════

# ── Tor ──────────────────────────────────────────────────────
TOR_SOCKS_HOST=tor
TOR_SOCKS_PORT=9050
# No control port: torrc is written when the tor container starts (docker/tor/entrypoint.sh).

# ── Crawling ─────────────────────────────────────────────────
MAX_DEPTH=3
MAX_CONCURRENT_REQUESTS=10
CRAWL_DELAY_MIN=2
CRAWL_DELAY_MAX=8
REQUEST_TIMEOUT=30
# New Tor circuit after this many pages (done through SOCKS isolation)
ROTATE_CIRCUIT_EVERY=50
MAX_PAGES_PER_DOMAIN=100
STAY_ON_DOMAIN=false

# ── Database ─────────────────────────────────────────────────
# Auto-generated by deploy.sh
POSTGRES_PASSWORD=changeme
# Keep the "+psycopg2" driver name: SQLAlchemy 2.1 maps a bare postgresql:// URL
# to a driver this image does not ship. upgrade.sh fixes older .env files.
DATABASE_URL=postgresql+psycopg2://scanner:changeme@postgres:5432/darkweb_scanner

# ── Dashboard ────────────────────────────────────────────────
# REQUIRED: must be a long random string (min 32 chars). The app refuses to start
# if this is empty or set to a placeholder value. Generate with:
#   openssl rand -hex 32
DASHBOARD_SECRET_KEY=change-me-to-a-long-random-string
# First administrator: /register works only while there are no users, and only
# with this token (min 24 chars). deploy.sh generates one. Once the admin account
# exists the token has no further use and can be removed.
SETUP_TOKEN=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SSL / Domain (Nginx) ──────────────────────────────────────────────────────
# Leave DOMAIN blank to use self-signed SSL (good for local/LAN use)
# Set DOMAIN to your public domain to get a free Let's Encrypt certificate
DOMAIN=
# Required if DOMAIN is set — used for Let's Encrypt certificate registration
SSL_EMAIL=
# Optional: www subdomain (if different from DOMAIN)
WWW_DOMAIN=

# ── Alerting: Webhook (Slack / Discord) ──────────────────────
# Leave blank to disable
ALERT_WEBHOOK_URL=

# ── Alerting: Email ──────────────────────────────────────────
# Leave blank to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Daily Digest (Mailgun) ────────────────────────────────────
# Free tier: 1 000 emails/month at mailgun.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Sender address shown in digest emails
MAILGUN_FROM=OSINT PH Threat Intel <digest@intel.osintph.info>

# ── Threat Intelligence Feeds ─────────────────────────────────
# AlienVault OTX — free at otx.alienvault.com
OTX_API_KEY=

# ransomware.live PRO — free at my.ransomware.live (3 000 calls/day)
RANSOMWARE_LIVE_API_KEY=

# ThreatFox (abuse.ch) — free at threatfox.abuse.ch
THREATFOX_API_KEY=

# WhiteIntel — free tier at whiteintel.io (credential exposure monitoring)
WHITEINTEL_API_KEY=

# DNSDumpster — for DNS investigation enrichment
DNSDUMPSTER_API_KEY=

# ── IP Investigation ──────────────────────────────────────────
# AbuseIPDB — free at https://www.abuseipdb.com/account/api (1 000 checks/day)
ABUSEIPDB_API_KEY=

# VirusTotal — free at https://www.virustotal.com/gui/my-apikey (4 req/min)
VIRUSTOTAL_API_KEY=

# HIBP — have-i-been-pwned.com API key ($3.50/month at haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# ── Telegram Scraper (optional) ───────────────────────────────────────────────
# Get API credentials at: https://my.telegram.org/apps
# Run 'make telegram-auth' once to authenticate before scanning
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Channel Monitor: your Telegram phone number (with country code). Used only by the
# one-time sign-in:  docker compose exec dashboard python -m darkweb_scanner.main channel-monitor-auth
TELEGRAM_PHONE=+1234567890
# Comma-separated list of public channel usernames (without @)
TELEGRAM_CHANNELS=channelname1,channelname2
TELEGRAM_SESSION_PATH=/app/data/telegram.session
TELEGRAM_LIMIT_PER_CHANNEL=200
# Channel Monitor (admins only, public channels only, one job at a time). Message
# text is sent to Google Translate unless a job turns translation off.
# Archives are deleted after this many days.
CHANNEL_MONITOR_RETENTION_DAYS=90
# Limits of a job. They are set here, never by the request.
# Messages one job may read (a job asks for 1 to this many; default 200).
CHANNEL_MONITOR_MAX_MESSAGES=5000
# Largest photo or image file (MB); larger ones are skipped.
CHANNEL_MONITOR_MAX_FILE_MB=50
# Highest "Max Video Size" a job may ask for (MB). 0 = never download videos.
CHANNEL_MONITOR_MAX_VIDEO_MB=200
# Media of one job (GB). When reached, media downloads stop and the text export finishes.
CHANNEL_MONITOR_MAX_JOB_GB=2
# Free disk space (GB). Below it no job starts and a running job stops.
CHANNEL_MONITOR_MIN_FREE_GB=5
# Largest ZIP that can be downloaded (GB). Keep MAX_JOB_GB at or below it.
CHANNEL_MONITOR_MAX_DOWNLOAD_GB=5

# ── Quick Scan ────────────────────────────────────────────────
# Max concurrent source checks per Quick Scan session
QUICK_SCAN_MAX_CONCURRENT=4
# Delay range between source requests (seconds). Falls back to CRAWL_DELAY_* if unset.
QUICK_SCAN_DELAY_MIN=2
QUICK_SCAN_DELAY_MAX=8

# ── Limits and timeouts (optional) ────────────────────────────
# The defaults suit one server; uncomment a line only to change it.
# Most bytes read from one crawled or Quick Scan page; the rest is not read.
# MAX_PAGE_BYTES=2097152
# Seconds to wait for Tor to answer before a crawl starts.
# TOR_CHECK_TIMEOUT=15
# A running crawl writes a heartbeat this often (seconds); a crawl whose
# heartbeat is older than CRAWL_STALE_SECONDS is ended as interrupted.
# CRAWL_HEARTBEAT_SECONDS=15
# CRAWL_STALE_SECONDS=120
# Heavy operations (DNS recon, Quick Scan, breach and IP checks) at once,
# in total and per user. Over the limit the answer is 429.
# HEAVY_JOBS_MAX=4
# HEAVY_JOBS_PER_USER=2
# Threads shared by all lookups that make many calls.
# FANOUT_WORKERS=24
# Seconds an answer from abuse.ch, crt.sh, WhiteIntel or DNSDumpster is reused (0 to 86400).
# UPSTREAM_CACHE_SECONDS=300
# VirusTotal calls per minute (the free key allows 4).
# VIRUSTOTAL_PER_MINUTE=4
# Alerts are sent from a queue, not from the crawl loop. SMTP timeout per step
# (seconds), alerts waiting to be sent (one more is dropped), and the longest a
# command waits at its end for queued alerts to go out (seconds).
# SMTP_TIMEOUT=15
# ALERT_QUEUE_SIZE=200
# ALERT_FLUSH_SECONDS=20
